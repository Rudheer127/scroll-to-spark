# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Spark Guide AI. Set at least one key. The guide tries LLM_PROVIDER first, then every other
# provider that has a key. LLM_PROVIDER is openrouter, cerebras or groq. Left empty it is
# openrouter when OPENROUTER_API_KEY is set, otherwise cerebras.
LLM_PROVIDER=
OPENROUTER_API_KEY=
# OpenRouter models. Empty means the free defaults in src/lib/env.ts:
#   main nvidia/nemotron-3.5-super-vl:free, fast inclusionai/ling-3.2-flash:free,
#   fallback openrouter/free (picks any available free model).
# Free models cost nothing but are capped (about 20 requests a minute and 50 a day without
# purchased credits, confirm on openrouter.ai/docs), and their providers may log or train on
# prompts. Optional paid upgrade: anthropic/claude-sonnet-5.5 (main), anthropic/claude-haiku-5.5 (fast).
# Every id must support structured outputs. Check them with: node scripts/check-models.mjs
OPENROUTER_MODEL_MAIN=
OPENROUTER_MODEL_FAST=
OPENROUTER_MODEL_FALLBACK=
# A free Groq key makes a good second provider; failover already supports it.
CEREBRAS_API_KEY=
GROQ_API_KEY=

# Image reading in the guide. On by default with OpenRouter (it uses a free vision model).
# With only Cerebras or Groq it is off unless GUIDE_VISION_MODEL is set. GUIDE_VISION_MODEL must
# be a vision capable model on GUIDE_VISION_PROVIDER (default: the primary provider). Check the
# provider's current model list; scripts/check-models.mjs prints which OpenRouter ids take images.
GUIDE_VISION_MODEL=
GUIDE_VISION_PROVIDER=

GIF_API_KEY=

# Google Maps Embed API key for the Events map preview (optional; restrict it to this site in Google Cloud)
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
